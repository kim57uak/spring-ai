@startuml
!pragma layout smetana
title 02. Package Policy (com.example.springai)

skinparam shadowing false
skinparam packageStyle rectangle

package "com.example.springai" {
  package "config" {
    class AgentCardProperties
    class AgentScopeProperties
    class HttpLlmProperties
    class LlmRateLimitProperties
    class McpProperties
    class ObservationConfig
    class SpringAiChatAdvisorConfig
  }

  package "advice" {
    class GlobalExceptionHandler
  }

  package "controller" {
    package "base" {
      class BaseAgentControllerSupport
      class HttpChatController
      class ProductAgentController
      class ReservationAgentController
      class SearchAgentController
    }

    package "a2a" {
      class BaseA2AControllerSupport
      class ProductA2AController
      class ReservationA2AController
      class SearchA2AController
      class AgentCardController
    }
  }

  package "exception" {
    class ChatProcessingException
    class McpException
  }

  package "service" {
    class HttpChatService
    class ScopedAgentChatService
    class AgentScopeResolver
    class AgentScopeActivationService

    package "chat" {
      enum ChatModelType
      class ChatRequestContext
      class ModelChatServiceFactory
      class LlmCallPolicy
      class LlmRequestRateLimiter
      interface ChatService
      interface SyncChatService
      interface StreamChatService
      interface StructuredChatService
      abstract class SpringAiCompatibleChatService

      package "advisor" {
        class PromptSanitizingAdvisor
        class SessionHistoryAdvisor
      }

      package "model" {
        class OpenAiModelChatService
        class GeminiModelChatService
        class GeminiLiteModelChatService
        class MistralModelChatService
      }

      package "tool" {
        class McpToolCallbackProvider
      }
    }

    package "llm" {
      class LlmCredentialValidator
    }

    package "agent" {
      package "orchestrator" {
        class AgentOrchestrator
      }
      package "graph" {
        interface AgentStateGraphFactory
      }
      package "plan" {
        interface PlanningService
      }
      package "execute" {
        interface ToolExecutionService
      }
      package "compose" {
        interface ResponseComposeService
      }
      package "prompt" {
        interface PromptTemplateService
      }
      package "runtime" {
        interface AgentLlmRuntime
      }
      package "security" {
        class HumanMessageService
        class PromptInjectionGuard
      }
      package "store" {
        interface ConversationStore
        interface GraphCheckpointStore
      }
    }
  }

  package "mcp" {
    class McpClientFactory
    class ProcessManager
    class StdioMcpClient
    class SseMcpClient
    class ToolSchemaRegistry
  }

  package "model.agent" {
    class AgentChatRequest
    class AgentScope
    class PlanningContext
    class ToolPlan
    class ToolExecutionResult
    class AgentGraphState
  }

  package "a2a" {
    package "dto" {
      class JsonRpcRequest
      class JsonRpcResponse
    }
    package "task" {
      interface A2ATaskStore
      class InMemoryA2ATaskStore
    }
    package "context" {
      class A2aExecutionContext
    }
    package "lifecycle" {
      class A2aLifecycleService
    }
    package "registry" {
      class AgentCardRegistry
    }
    package "mapper" {
      class A2AResponseMapper
    }
  }
}

note bottom
Rules
- controller/service는 API 진입과 조율 책임만 가진다
- HttpChatController는 unrestricted MCP 접근을 유지한다
- Product/Reservation/Search controller는 scoped MCP 접근을 사용한다
- Product/Reservation/Search A2A controller는 동일 scope 정책을 사용한다
- 예외 처리와 예외 타입은 advice/exception 패키지에서 분리한다
- orchestrator는 포트(interface)에만 의존한다
- 모델 라우팅은 ChatModelType + ModelChatServiceFactory로 일원화한다
- MCP tool callback은 mcp 설정 allowlist를 준수한다
- A2A task는 scope ownership 검증을 통과한 경우에만 get/cancel/list 허용
end note

@enduml
