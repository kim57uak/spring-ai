@startuml
!pragma layout smetana
title 01. Agentic AI System Context (Current Source)

skinparam shadowing false
skinparam componentStyle rectangle

actor User

rectangle "Client Channel" {
  [Web UI] as WebUi
}

rectangle "spring-ai application" {
  [HttpChatController\n(unrestricted)] as HttpController
  [ProductAgentController] as ProductController
  [ReservationAgentController] as ReservationController
  [SearchAgentController] as SearchController
  [ProductA2AController] as ProductA2AController
  [ReservationA2AController] as ReservationA2AController
  [SearchA2AController] as SearchA2AController
  [AgentCardController] as AgentCardController
  [GlobalExceptionHandler] as Advice
  [HttpChatService] as HttpChatService
  [ScopedAgentChatService] as ScopedChatService
  [AgentScopeResolver] as ScopeResolver
  [AgentScopeActivationService] as ScopeActivationService
  [AgentOrchestrator] as Orchestrator
  [LangGraph4J CompiledGraph] as StateGraph
  [PlanningService] as PlanningService
  [ToolExecutionService] as ToolExecutionService
  [ResponseComposeService] as ResponseComposeService
  [DefaultAgentLlmRuntime] as LlmRuntime
  [ModelChatServiceFactory] as ChatFactory
  [Provider ChatService] as ProviderChatService
  [McpClientFactory] as McpClientFactory
  [ToolSchemaRegistry] as ToolSchemaRegistry
  [A2ATaskStore] as A2ATaskStore
  [A2aLifecycleService] as A2aLifecycleService
  [AgentCardRegistry] as AgentCardRegistry
}

database "Redis" as Redis {
  [Conversation Store] as ConversationStore
  [Graph Checkpoint Store] as CheckpointStore
}

cloud "LLM Provider" {
  [Spring AI Runtime Port] as SpringAiRuntime
}

node "MCP Servers" {
  [SSE MCP\n10.225.18.50:8080] as SseMcp
  [stdio MCP\nsearch-mcp-server] as StdioMcp
}

artifact "mcp.yml" as McpYml

User --> WebUi
WebUi --> HttpController : /api/http-chat/*
WebUi --> ProductController : /api/product-agent/*
WebUi --> ReservationController : /api/reservation-agent/*
WebUi --> SearchController : /api/search-agent/*
WebUi --> ProductA2AController : /a2a/product
WebUi --> ReservationA2AController : /a2a/reservation
WebUi --> SearchA2AController : /a2a/search
WebUi --> AgentCardController : /.well-known/agent.json
HttpController --> HttpChatService
ProductController --> ScopedChatService
ReservationController --> ScopedChatService
SearchController --> ScopedChatService
ProductA2AController --> ScopedChatService
ReservationA2AController --> ScopedChatService
SearchA2AController --> ScopedChatService
ScopedChatService --> ScopeResolver
ScopeResolver --> McpYml
AgentCardController --> ScopeActivationService
AgentCardController --> AgentCardRegistry
HttpController --> Advice : exception mapped to ErrorResponse
HttpChatService --> Orchestrator
ScopedChatService --> Orchestrator
Orchestrator --> StateGraph
Orchestrator --> PlanningService
Orchestrator --> ToolExecutionService
Orchestrator --> ResponseComposeService
Orchestrator --> ConversationStore
Orchestrator --> CheckpointStore
Orchestrator --> A2aLifecycleService
A2aLifecycleService --> A2ATaskStore
PlanningService --> LlmRuntime
ResponseComposeService --> LlmRuntime
LlmRuntime --> ChatFactory
ChatFactory --> ProviderChatService
ProviderChatService --> SpringAiRuntime
ToolExecutionService --> McpClientFactory
PlanningService --> ToolSchemaRegistry
ToolExecutionService --> ToolSchemaRegistry
ToolSchemaRegistry --> McpClientFactory : reconnect-first
McpYml --> McpClientFactory
McpClientFactory --> SseMcp
McpClientFactory --> StdioMcp

note right of Orchestrator
Graph flow
- load history/checkpoint
- plan
- execute (optional, iterative)
- compose stream
- persist
- if A2A context exists:
  update task lifecycle
end note

note right of ScopeActivationService
A2A/AgentCard exposure control
- enabled scopes from agent.cards.enabled-scopes
- fallback to configured agent.scopes
end note

note bottom of Redis
Externalized state
- conversation history
- graph checkpoint
end note

@enduml
