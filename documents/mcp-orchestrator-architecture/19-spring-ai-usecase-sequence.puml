@startuml
!pragma layout smetana
title 19. Spring AI Agentic Sequence (Scoped + Mixed MCP Transport)

skinparam shadowing false

actor User
participant "Agent Controller\n(Http/Product/Reservation/Search)" as Controller
participant "Chat Service\n(HttpChatService/ScopedAgentChatService)" as ChatService
participant "AgentScopeResolver" as ScopeResolver
participant "AgentOrchestrator" as Orchestrator
participant "Conversation Store (Redis)" as HistoryRedis
participant "Graph Checkpoint Store (Redis)" as CheckpointRedis
participant "LangGraph4J CompiledGraph" as StateGraph
participant "PlanningService" as Planner
participant "ToolExecutionService" as Executor
participant "ResponseComposeService" as Composer
participant "DefaultAgentLlmRuntime" as Runtime
participant "ModelChatServiceFactory" as ChatFactory
participant "Provider ChatService" as ProviderChatService
participant "ToolSchemaRegistry" as SchemaRegistry
participant "McpClientFactory" as McpFactory
participant "SSE MCP Server\n10.225.18.50:8080" as SseMcp
participant "stdio MCP Server\nsearch-mcp-server" as StdioMcp

User -> Controller : chat stream request
Controller -> ScopeResolver : resolve scope (scoped controller only)
Controller -> ChatService : streamChat(...)
ChatService -> Orchestrator : execute(request)

Orchestrator -> HistoryRedis : load history
Orchestrator -> CheckpointRedis : load checkpoint
Orchestrator -> StateGraph : invoke(state)
StateGraph -> Planner : plan(context)
Planner -> Runtime : complete(planning prompt)
Planner -> SchemaRegistry : loadTools(server, scope)

alt tool required
  StateGraph -> Executor : execute(plan, context)
  Executor -> SchemaRegistry : loadTools(server, scope)
  Executor -> McpFactory : createClient(transport)
  alt transport=sse
    Executor -> SseMcp : call tool
    SseMcp --> Executor : tool result
  else transport=stdio
    Executor -> StdioMcp : call tool
    StdioMcp --> Executor : tool result
  end
else no tool required
  StateGraph --> Orchestrator : skip execution
end

Orchestrator -> Composer : streamCompose(context)
Composer -> Runtime : stream(prompt, model, sessionId)
Runtime -> ChatFactory : resolveStream(ChatModelType)
ChatFactory --> Runtime : StreamChatService
Runtime -> ProviderChatService : streamGenerate(prompt, context)
ProviderChatService --> Runtime : tokens
Runtime --> Composer : tokens
Composer --> Orchestrator : chunks
Orchestrator --> ChatService : chunks
ChatService --> Controller : chunks
Controller --> User : SSE stream

Orchestrator -> HistoryRedis : save history
Orchestrator -> CheckpointRedis : save checkpoint

note right of Runtime
Cost guardrail
- LlmCallPolicy + LlmRequestRateLimiter 적용
- retry/backoff는 llm.rate-limit.* 설정 기반
end note

@enduml
