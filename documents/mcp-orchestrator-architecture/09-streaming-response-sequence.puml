@startuml
!pragma layout smetana
title 09. Streaming Response Sequence (Unified Controllers)

skinparam shadowing false

actor User
participant "Agent Controller\n(Http/Product/Reservation/Search)" as Controller
participant "Chat Service\n(HttpChatService/ScopedAgentChatService)" as ChatService
participant "AgentScopeResolver" as ScopeResolver
participant "AgentOrchestrator" as Orchestrator
participant "ResponseComposeService" as Composer
participant "DefaultAgentLlmRuntime" as Runtime
participant "ModelChatServiceFactory" as ChatFactory
participant "Provider ChatService" as ProviderChatService
participant "Conversation Store (Redis)" as HistoryRedis
participant "Checkpoint Store (Redis)" as CheckpointRedis

User -> Controller : HTTP stream request
Controller -> ScopeResolver : resolve scope
Controller -> ChatService : streamChat(...)
ChatService -> Orchestrator : execute(request)

Orchestrator --> Controller : first summary chunk
Controller --> User : SSE data(summary)

Orchestrator -> Composer : streamCompose(context)
Composer -> Runtime : stream(prompt, model, sessionId)
Runtime -> ChatFactory : resolveStream(ChatModelType.from(model))
ChatFactory --> Runtime : StreamChatService
Runtime -> ProviderChatService : streamGenerate(prompt, context)
ProviderChatService --> Runtime : Flux<String>
Runtime --> Composer : Flux<String>

loop token stream
  Composer -> Runtime : request next chunk
  Runtime -> ProviderChatService : next token
  ProviderChatService --> Runtime : token
  Runtime --> Composer : token
  Composer --> Orchestrator : chunk(token)
  Orchestrator --> ChatService : chunk(token)
  ChatService --> Controller : chunk(token)
  Controller --> User : SSE data(token)
end

Orchestrator -> HistoryRedis : save history
Orchestrator -> CheckpointRedis : save checkpoint
Controller --> User : SSE complete

note right of ScopeResolver
HttpChatController -> unrestricted scope
Product/Reservation/Search -> restricted scope
end note

@enduml
