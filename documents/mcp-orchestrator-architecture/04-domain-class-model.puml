@startuml
!pragma layout smetana
title 04. SpringAI Domain / Contract Class Model (Current Source, 2026-04-18)

skinparam shadowing false
skinparam classAttributeIconSize 0

class AgentChatRequest {
  +sessionId: String
  +message: String
  +model: String
  +scope: AgentScope
  +a2aContext: A2aExecutionContext
}

class A2aExecutionContext {
  +taskId: String
  +scopeName: AgentScopeName
  +method: String
}

class AgentScope {
  +allowedServers: Set<String>
  +allowedToolsByServer: Map<String, Set<String>>
  +unrestricted: boolean
}

class PlanningContext {
  +sessionId: String
  +userMessage: String
  +model: String
  +history: List<String>
  +currentNode: String
  +checkpointId: String
  +plans: List<ToolPlan>
  +executionResult: ToolExecutionResult
  +toolTrace: List<String>
  +scope: AgentScope
}

class AgentGraphState {
  +SESSION_ID
  +USER_MESSAGE
  +MODEL
  +HISTORY
  +CHECKPOINT_ID
  +CURRENT_NODE
  +PLAN_*
  +EXEC_*
  +SCOPE_*
}

class ToolPlan {
  +capability: String
  +serverName: String
  +toolName: String
  +reason: String
  +arguments: Map<String, Object>
  +toolRequired: boolean
}

class ToolExecutionResult {
  +serverName: String
  +toolName: String
  +rawPayload: String
  +usedArguments: Map<String, Object>
  +success: boolean
  +executed: boolean
  +terminalAfterExecution: boolean
}

class A2aStructuredResponse {
  +response: String
  +structuredData: Object
}

class A2aTaskSnapshot {
  +taskId: String
  +scopeName: AgentScopeName
  +sessionId: String
  +status: A2aTaskStatus
  +requestMessage: String
  +responsePayload: String
  +errorCode: String
  +errorMessage: String
}

enum A2aTaskStatus {
  SUBMITTED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

interface ConversationStore {
  +load(sessionId): List<String>
  +save(sessionId, history): void
  +clear(sessionId): void
}

interface GraphCheckpointStore {
  +loadCheckpoint(sessionId): Optional<String>
  +saveCheckpoint(sessionId, checkpoint): void
  +clear(sessionId): void
}

interface PlanningService {
  +plan(context): List<ToolPlan>
}

interface ToolExecutionService {
  +execute(plan, context): ToolExecutionResult
}

interface ResponseComposeService {
  +streamCompose(context): Flux<String>
}

interface AgentStateGraphFactory {
  +getCompiledGraph(): CompiledGraph<AgentGraphState>
}

interface A2ATaskStore {
  +create(scopeName, sessionId, requestMessage): A2aTaskSnapshot
  +get(taskId, scopeName): Optional<A2aTaskSnapshot>
  +list(scopeName, limit): List<A2aTaskSnapshot>
  +markRunning(...): Optional<A2aTaskSnapshot>
  +markCompleted(...): Optional<A2aTaskSnapshot>
  +markFailed(...): Optional<A2aTaskSnapshot>
  +cancel(...): Optional<A2aTaskSnapshot>
}

class A2aLifecycleService
class A2AResponseMapper
class AgentCardRegistry
class RedisConversationStore
class RedisGraphCheckpointStore
class InMemoryA2ATaskStore
class RedisA2ATaskStore
class HeuristicPlanningService
class McpToolExecutionService
class LlmResponseComposeService
class LangGraphAgentStateGraphFactory

ConversationStore <|.. RedisConversationStore
GraphCheckpointStore <|.. RedisGraphCheckpointStore
A2ATaskStore <|.. InMemoryA2ATaskStore
A2ATaskStore <|.. RedisA2ATaskStore
PlanningService <|.. HeuristicPlanningService
ToolExecutionService <|.. McpToolExecutionService
ResponseComposeService <|.. LlmResponseComposeService
AgentStateGraphFactory <|.. LangGraphAgentStateGraphFactory

AgentChatRequest --> AgentScope
AgentChatRequest --> A2aExecutionContext
AgentGraphState --> PlanningContext
PlanningContext --> ToolPlan
PlanningContext --> ToolExecutionResult
PlanningContext --> AgentScope
A2aExecutionContext --> AgentScopeName
A2aLifecycleService --> A2ATaskStore
A2AResponseMapper --> A2aTaskSnapshot
AgentCardRegistry --> AgentScopeName

note bottom of PlanningContext
Runtime orchestration state shared across:
- planner
- executor
- composer
- persistence
end note

note bottom of A2aTaskSnapshot
Ownership and lifecycle are enforced by:
- scopeName
- sessionId
- status transition helpers
end note

@enduml
