@startuml
!pragma layout smetana
title 07. Reservation Agent Sequence (Scoped + SSE MCP, Synced with Source, 2026-05-14)

skinparam shadowing false

actor User
participant "ReservationAgentController" as Controller
participant "ScopedAgentChatService" as ChatService
participant "AgentScopeResolver" as ScopeResolver
participant "AgentOrchestrator" as Orchestrator
participant "LangGraph4J CompiledGraph" as StateGraph
participant "PlanningService" as Planner
participant "ToolSchemaRegistry" as SchemaRegistry
participant "ToolExecutionService" as Executor
participant "McpClientFactory" as McpFactory
participant "SSE MCP Server\nhttp://10.225.18.50:8080" as ReservationMcp
participant "ResponseComposeService" as Composer
participant "DefaultAgentLlmRuntime" as Runtime

User -> Controller : "예약 생성해줘" (/api/reservation-agent/stream)
Controller -> ScopeResolver : resolve(reservation scope)
ScopeResolver --> Controller : allowedServers={reservation},\nallowedTools={createReservation}
Controller -> ChatService : streamChat(sessionId, message, model, scope)
ChatService -> Orchestrator : execute(request+scope)
Orchestrator -> StateGraph : invoke(state)

StateGraph -> Planner : plan(context + scope)
Planner -> SchemaRegistry : loadTools(reservation, scope)
SchemaRegistry -> McpFactory : createClient(transport=sse)

StateGraph -> Executor : execute(plan, context + scope)
Executor -> SchemaRegistry : loadTools(reservation, scope)
Executor -> McpFactory : createClient(transport=sse)
Executor -> ReservationMcp : callTool(createReservation, args) via SSE
ReservationMcp --> Executor : reservation result

StateGraph --> Orchestrator : context(updated)
Orchestrator -> Composer : streamCompose(context)
Composer -> Runtime : stream(prompt, model, sessionId)
Runtime --> Controller : response chunks
Controller --> User : SSE stream

@enduml
