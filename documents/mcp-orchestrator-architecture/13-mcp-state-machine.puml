@startuml
!pragma layout smetana
title 13. MCP State Machine

skinparam shadowing false

[*] --> REQUEST_VALIDATED
REQUEST_VALIDATED --> HISTORY_LOADED
HISTORY_LOADED --> STATE_LOADED
STATE_LOADED --> PLANNED
PLANNED --> EXECUTING_RESEARCH
PLANNED --> EXECUTING_MARKET
PLANNED --> EXECUTING_ACTION
EXECUTING_RESEARCH --> HANDOFF_REQUIRED
EXECUTING_MARKET --> HANDOFF_REQUIRED
EXECUTING_ACTION --> HANDOFF_REQUIRED
HANDOFF_REQUIRED --> PLANNED : conditional edge
EXECUTING_RESEARCH --> COMPOSING : no handoff
EXECUTING_MARKET --> COMPOSING : no handoff
EXECUTING_ACTION --> COMPOSING : no handoff
COMPOSING --> PERSISTED
PERSISTED --> STREAMING
STREAMING --> COMPLETED
HUMAN_MESSAGE --> [*]
COMPLETED --> [*]
@enduml
