@startuml
!pragma layout smetana
title 10. Exception Handling (Current Source)

skinparam shadowing false
skinparam componentStyle rectangle

class HttpChatController
class HttpChatService
class AgentOrchestrator
class HeuristicPlanningService
class LlmResponseComposeService
class DefaultAgentLlmRuntime
class ModelChatServiceFactory
class LlmCallPolicy
class SpringAiCompatibleChatService
class GlobalExceptionHandler

class ChatProcessingException
class McpException
class McpClientCreationException
class McpProcessLaunchException
class McpToolCallException
class McpValidationException

HttpChatController --> HttpChatService
HttpChatService --> AgentOrchestrator
AgentOrchestrator --> HeuristicPlanningService
AgentOrchestrator --> LlmResponseComposeService
HeuristicPlanningService --> DefaultAgentLlmRuntime
LlmResponseComposeService --> DefaultAgentLlmRuntime
DefaultAgentLlmRuntime --> ModelChatServiceFactory
ModelChatServiceFactory --> SpringAiCompatibleChatService
SpringAiCompatibleChatService --> LlmCallPolicy

LlmCallPolicy --> ChatProcessingException : throw
GlobalExceptionHandler --> ChatProcessingException : @ExceptionHandler
GlobalExceptionHandler --> IllegalArgumentException : @ExceptionHandler
GlobalExceptionHandler --> IllegalStateException : @ExceptionHandler
GlobalExceptionHandler --> MethodArgumentNotValidException : @ExceptionHandler
GlobalExceptionHandler --> ConstraintViolationException : @ExceptionHandler
GlobalExceptionHandler --> WebClientResponseException : @ExceptionHandler

McpException <|-- McpClientCreationException
McpException <|-- McpProcessLaunchException
McpException <|-- McpToolCallException
McpException <|-- McpValidationException

note bottom of GlobalExceptionHandler
Return ErrorResponse with sanitized message
- no stack trace
- no token/secret
- no internal payload leak
end note

note right of LlmCallPolicy
Maps upstream errors
- 401 -> auth guidance message
- 429/5xx -> retry/backoff policy
end note

@enduml
