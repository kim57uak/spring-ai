@startuml
!pragma layout smetana
title 03. Agentic MCP Component Architecture (Current Source)

skinparam shadowing false
skinparam componentStyle rectangle

package "entry" {
  [HttpChatController] as Controller
  [GlobalExceptionHandler] as Advice
}

package "service" {
  [HttpChatService] as ChatService
  [AgentOrchestrator] as Orchestrator
  [LlmCallPolicy] as LlmPolicy
}

package "agent ports" {
  interface "PlanningService" as PlanningPort
  interface "ToolExecutionService" as ExecutePort
  interface "ResponseComposeService" as ComposePort
  interface "ConversationStore" as ConversationStorePort
  interface "GraphCheckpointStore" as CheckpointStorePort
  interface "AgentStateGraphFactory" as GraphFactoryPort
}

package "agent impl" {
  [HeuristicPlanningService] as PlanningImpl
  [McpToolExecutionService] as ExecuteImpl
  [LlmResponseComposeService] as ComposeImpl
  [LangGraphAgentStateGraphFactory] as GraphFactoryImpl
  [RedisConversationStore] as ConversationStoreImpl
  [RedisGraphCheckpointStore] as CheckpointStoreImpl
  [PromptInjectionGuard] as PromptGuard
  [HumanMessageService] as HumanMessageService
}

package "runtime/integration" {
  interface "AgentLlmRuntime" as LlmRuntime
  [DefaultAgentLlmRuntime] as LlmRuntimeImpl
  [McpClientFactory] as McpFactory
}

Controller --> ChatService
Advice --> ChatService : error mapping boundary
ChatService --> Orchestrator
ChatService --> LlmPolicy

Orchestrator --> PlanningPort
Orchestrator --> ExecutePort
Orchestrator --> ComposePort
Orchestrator --> ConversationStorePort
Orchestrator --> CheckpointStorePort
Orchestrator --> GraphFactoryPort
Orchestrator --> HumanMessageService

PlanningPort <|.. PlanningImpl
ExecutePort <|.. ExecuteImpl
ComposePort <|.. ComposeImpl
GraphFactoryPort <|.. GraphFactoryImpl
ConversationStorePort <|.. ConversationStoreImpl
CheckpointStorePort <|.. CheckpointStoreImpl

PlanningImpl --> PromptGuard
ExecuteImpl --> PromptGuard
ComposeImpl --> LlmRuntime
PlanningImpl --> LlmRuntime
ExecuteImpl --> McpFactory
LlmRuntime <|.. LlmRuntimeImpl

note right of Orchestrator
Depends on interfaces first
and composes end-to-end pipeline.
end note

@enduml
