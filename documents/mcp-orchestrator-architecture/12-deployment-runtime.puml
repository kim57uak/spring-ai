@startuml
!pragma layout smetana
title 12. Deployment Runtime

skinparam shadowing false
skinparam componentStyle rectangle

node "App Runtime" {
  [HttpChatController] as LegacyController
  [HttpChatService] as LegacyService
  [HttpChatController] as Controller
  [AgentOrchestrator] as Orchestrator
  [AgentStateGraphFactory] as GraphFactory
  [LangGraph4J StateGraph] as StateGraph
  [Spring AI Agent Runtime] as PlanningChatRuntime
  [McpClientFactory] as McpClientFactory
}

database "Redis" as RedisB
component "Conversation Store Adapter" as SpringAiMemoryStore
component "LangGraph4J Checkpoint Store Adapter" as LangGraphCheckpointStore
cloud "Spring AI Provider" as Provider
node "MCP Servers" as McpServers {
  [Research MCP] as SupplyCost
  [Market MCP] as Reservation
  [Action MCP] as SaleProduct
}

LegacyController --> LegacyService
Controller --> Orchestrator
Orchestrator --> GraphFactory
GraphFactory --> StateGraph
StateGraph --> RedisB : default state/history store
StateGraph --> LangGraphCheckpointStore : checkpoint implementation
Orchestrator --> PlanningChatRuntime
Orchestrator --> McpClientFactory
McpClientFactory --> SupplyCost
McpClientFactory --> Reservation
McpClientFactory --> SaleProduct
Orchestrator --> RedisB : default history/state store
Orchestrator --> SpringAiMemoryStore : history store
PlanningChatRuntime --> Provider

note bottom of RedisB
conversation history + graph state + checkpoint
end note

note bottom of SpringAiMemoryStore
ConversationStore implementation
end note

note bottom of StateGraph
LangGraph4J is required
StateGraph handles planning and checkpoint
end note

note bottom of LangGraphCheckpointStore
GraphCheckpointStore implementation
end note

@enduml
