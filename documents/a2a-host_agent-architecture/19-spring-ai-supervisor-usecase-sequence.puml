@startuml
title 19. Supervisor Runtime Sequence (Synced with Source, 2026-05-14)

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 20

actor User
participant "SupervisorA2AController" as Controller
participant "SupervisorA2ARequestValidator" as Validator
participant "SupervisorAgentService" as AgentService
participant "SupervisorPreHitlA2uiService" as PreHitlA2ui
participant "HitlGateService" as HitlGate
participant "SupervisorExecutionService" as ExecutionService
participant "SupervisorAgentOrchestrator" as Orchestrator
participant "SupervisorGraphExecutionService" as GraphExecution
participant "SupervisorExecutionStateLoader" as StateLoader
participant "LangGraph CompiledGraph" as Graph
participant "SupervisorPlanningService" as Planner
participant "A2AInvocationService" as Invoker
participant "HandoffPolicyService" as HandoffPolicy
participant "SupervisorSwarmCoordinator" as Swarm
participant "SupervisorResponseComposeService" as Composer
participant "SupervisorExecutionPersistenceService" as Persistence

User -> Controller : request
Controller -> Validator : precheck + validate

alt send/stream request
  Controller -> AgentService : send(...) or streamEvents(...)
  AgentService -> PreHitlA2ui : build(sessionId, message, model)

  alt pre-HITL A2UI exists
    AgentService --> Controller : task or progress + text + a2ui
  else no pre-HITL A2UI
    AgentService -> HitlGate : evaluate(...)
    alt HITL required
      AgentService -> HitlGate : openReview(...)
      AgentService --> Controller : waiting review response/events
    else HITL passed
      AgentService -> ExecutionService : executeSync(...) / executeStreamEvents(...)
      ExecutionService -> Orchestrator : executeEvents(...)
      Orchestrator -> GraphExecution : execute(...)
      GraphExecution -> StateLoader : load(sessionId)
      StateLoader -> Swarm : loadLatestBySession
      GraphExecution -> Graph : invoke(state)
      Graph -> Planner : plan(context)
      Graph -> Swarm : applyRoutingRule(...)

      loop invoke / handoff cycle
        Graph -> Invoker : invoke(invocationContext)
        Invoker --> Graph : DownstreamCallResult
        Graph -> HandoffPolicy : evaluate(handoffContext)
        HandoffPolicy --> Graph : HandoffValidationResult list
        Graph -> Swarm : record invocation/handoff events
      end

      Orchestrator -> Composer : streamComposeEvents(context)
      Composer --> Orchestrator : text / a2ui events
      Orchestrator -> Persistence : persistCompletion / markCompleted or markFailed
      Orchestrator --> Controller : SupervisorOutputEvent stream
    end
  end
else review endpoint
  Controller -> AgentService : getReview / decideReview / decideReviewStream
  AgentService --> Controller : review/task result
end

Controller --> User : JSON-RPC or SSE

@enduml
