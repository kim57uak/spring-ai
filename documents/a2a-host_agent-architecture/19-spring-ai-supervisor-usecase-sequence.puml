@startuml
!pragma layout smetana
title 19. Spring AI Supervisor Usecase Sequence (A2A Controller Only)

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 20

actor User
participant "SupervisorA2AController" as Controller
participant "SupervisorAgentService" as Service
participant "SupervisorAgentOrchestrator" as Orchestrator
participant "Swarm State Store" as SwarmStore
participant "SupervisorPlanningService\n<size:10><color:#7A5B00>CallLLM</color></size>" as Planner #FFE7A8
participant "DefaultSupervisorLlmRuntime" as Runtime #FFF4CC
participant "HITL Policy Service" as HitlPolicy
participant "HITL Decision Service" as HitlDecision
participant "A2AInvocationService" as Invoker
participant "Handoff Policy Service" as HandoffPolicy
participant "SupervisorResponseComposeService\n<size:10><color:#7A5B00>CallLLM</color></size>" as Composer #FFE7A8
participant "SupervisorProgressSupport" as Progress

User -> Controller : JSON-RPC message/send|message/stream
Controller -> Service : send(...) or stream(...)
Service -> Orchestrator : execute(supervisorRequest)
Orchestrator -> SwarmStore : load shared state
Orchestrator -> Planner : plan(context)
Planner -> Runtime : complete(planning prompt)\n<size:10><color:#7A5B00>CallLLM</color></size>
Runtime --> Planner : routing plans
Orchestrator -> HitlPolicy : evaluate risk + data-mutation
HitlPolicy --> Orchestrator : required?
alt HITL required
  Orchestrator -> HitlDecision : wait decision
  HitlDecision --> Orchestrator : APPROVE or CANCEL
else no HITL
end
alt APPROVE
  Orchestrator -> Invoker : invoke(plans)
  Invoker --> Orchestrator : downstream results
  Orchestrator -> HandoffPolicy : evaluate/apply handoff
  HandoffPolicy --> Orchestrator : append plan or skip
  Orchestrator -> Progress : line(stage=handoff, metadata)
  Orchestrator -> Composer : streamCompose(context + results)
else CANCEL
  Orchestrator --> Controller : canceled response
end
Composer -> Runtime : stream(compose prompt)\n<size:10><color:#7A5B00>CallLLM</color></size>
Runtime --> Composer : token chunks
Composer --> Controller : chunks
Controller --> User : JSON-RPC/SSE response
Orchestrator -> SwarmStore : save review/decision events

