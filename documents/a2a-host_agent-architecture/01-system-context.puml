@startuml
!pragma layout smetana
title 01. A2A Supervisor Agent System Context

skinparam shadowing false
skinparam componentStyle rectangle

actor User

rectangle "Client Channel" {
  [Web UI / API Client] as Client
}

rectangle "Supervisor Agent (spring-ai + springsupervisorai)" {
  [SupervisorA2AController\n/a2a/supervisor] as Controller
  [SupervisorA2ARequestValidator] as Validator
  [HitlReviewController\n/a2a/supervisor/tasks/review] as HitlReviewController
  [CircuitBreakerController\n/a2a/circuit-breaker] as CircuitBreakerController
  [SupervisorAgentService] as Service
  [SupervisorRequestIdempotencyService] as Idempotency
  [SupervisorPreHitlA2uiService] as PreHitlA2ui
  [HitlPolicyService] as HitlPolicy
  [HitlDecisionService] as HitlDecision
  [SupervisorA2aLifecycleService] as Lifecycle
  [SupervisorAgentOrchestrator] as Orchestrator
  [LangGraph4J CompiledGraph] as Graph
  [SupervisorPlanningService] as Planner
  [A2AInvocationService] as Invocation
  [HandoffPolicyService] as Handoff
  [SupervisorSwarmCoordinator] as SwarmCoordinator
  [SupervisorResponseComposeService] as Composer
  [SupervisorA2uiService] as A2uiService
  [DefaultSupervisorLlmRuntime] as LlmRuntime
  [SupervisorProgressSupport] as ProgressSupport
  [A2AClientRegistry] as Registry
  [SupervisorGlobalExceptionHandler] as Advice
}

database "Stores / Redis or InMemory" as Stores {
  [Conversation Store] as ConversationStore
  [Graph Checkpoint Store] as CheckpointStore
  [Swarm State Store] as SwarmStateStore
  [Review Store] as ReviewStore
  [Task Store] as TaskStore
}

cloud "Downstream A2A Agents" {
  [Product Agent A2A] as ProductAgent
  [Reservation Agent A2A] as ReservationAgent
  [Search Agent A2A] as SearchAgent
}

artifact "application.yml / a2a-supervisor-hitl.yml" as Config

User --> Client
Client --> Controller : /a2a/supervisor\nJSON-RPC + SSE
Controller --> Validator
Controller --> Service
Controller --> Advice
Service --> Idempotency
Service --> HitlPolicy
Service --> HitlDecision
Service --> Lifecycle
Service --> Orchestrator
Orchestrator --> Graph
Graph --> Planner
Graph --> Invocation
Graph --> Handoff
Graph --> SwarmCoordinator
Orchestrator --> Composer
Composer --> A2uiService
Planner --> LlmRuntime
HitlPolicy --> LlmRuntime
Composer --> LlmRuntime
Invocation --> Registry
Registry --> Config
Invocation --> ProductAgent
Invocation --> ReservationAgent
Invocation --> SearchAgent
Orchestrator --> ConversationStore
Orchestrator --> CheckpointStore
Orchestrator --> SwarmStateStore
HitlDecision --> ReviewStore
Lifecycle --> TaskStore

note right of Service
Current request entry flow
- validate + sanitize input
- HITL pre-gate evaluation
- create task state
- execute orchestrator only when review is not required
- review APPROVE/CANCEL handled via tasks/review/*
end note

note right of Orchestrator
Current execution flow
- load history/checkpoint/swarm
- run LangGraph
- invoke downstream A2A agents
- evaluate/apply handoff
- compose text or A2UI response
- persist history/checkpoint/task state
end note
@enduml
