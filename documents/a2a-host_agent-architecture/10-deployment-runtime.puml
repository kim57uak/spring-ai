@startuml
!pragma layout smetana
title 10. Supervisor Agent Deployment Runtime

skinparam shadowing false
skinparam componentStyle rectangle

node "Supervisor Agent Spring Boot Runtime" {
  [SupervisorA2AController] as SupervisorA2AController
  [SupervisorAgentService] as SupervisorService
  [SupervisorAgentOrchestrator] as SupervisorOrchestrator
  [LangGraphSupervisorStateGraphFactory] as GraphFactory
  [LlmSupervisorPlanningService] as Planner
  [DefaultA2AInvocationService] as Invoker
  [LlmSupervisorResponseComposeService] as Composer
  [A2AClientRegistry] as Registry
  [A2AJsonRpcClient] as A2AClient
  [DefaultSupervisorLlmRuntime] as LlmRuntime
}

database "Redis" as Redis {
  [RedisConversationStore] as ConversationStore
  [RedisGraphCheckpointStore] as CheckpointStore
}

cloud "LLM Providers" as LlmProviders

node "Downstream A2A Agents" {
  [Product Agent] as ProductAgent
  [Reservation Agent] as ReservationAgent
  [Search Agent] as SearchAgent
}

artifact "a2a-supervisor.yml" as SupervisorConfig

SupervisorA2AController --> SupervisorService
SupervisorService --> SupervisorOrchestrator
SupervisorOrchestrator --> GraphFactory
SupervisorOrchestrator --> Planner
SupervisorOrchestrator --> Invoker
SupervisorOrchestrator --> Composer
SupervisorOrchestrator --> ConversationStore
SupervisorOrchestrator --> CheckpointStore
Planner --> LlmRuntime
Composer --> LlmRuntime
LlmRuntime --> LlmProviders
Invoker --> Registry
Registry --> SupervisorConfig
Invoker --> A2AClient
A2AClient --> ProductAgent
A2AClient --> ReservationAgent
A2AClient --> SearchAgent

@enduml
