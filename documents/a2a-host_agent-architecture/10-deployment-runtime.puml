@startuml
!pragma layout smetana
title 10. Supervisor Agent Deployment Runtime

skinparam shadowing false
skinparam componentStyle rectangle

node "Supervisor Agent Spring Boot Runtime" {
  [SupervisorA2AController] as Controller
  [SupervisorA2ARequestValidator] as Validator
  [SupervisorAgentService] as Service
  [SupervisorA2aLifecycleService] as Lifecycle
  [SupervisorRequestIdempotencyService] as Idempotency
  [SupervisorAgentOrchestrator] as Orchestrator
  [LangGraphSupervisorStateGraphFactory] as GraphFactory
  [LlmSupervisorPlanningService] as Planner
  [DefaultA2AInvocationService] as Invoker
  [DefaultHandoffPolicyService] as HandoffPolicy
  [DefaultSupervisorSwarmCoordinator] as SwarmCoordinator
  [LlmSupervisorResponseComposeService] as Composer
  [DefaultSupervisorProductInfoA2uiService] as A2uiService
  [LlmHitlPolicyService] as HitlPolicy
  [DefaultHitlDecisionService] as HitlDecision
  [A2AClientRegistry] as Registry
  [A2AJsonRpcClient] as A2AClient
  [DefaultSupervisorLlmRuntime] as LlmRuntime
  [ReflectionSupervisorChatGateway] as ChatGateway
  [SupervisorProgressSupport] as ProgressSupport
}

database "Redis / InMemory Stores" as Stores {
  [ConversationStore] as ConversationStore
  [GraphCheckpointStore] as CheckpointStore
  [SupervisorSwarmStateStore] as SwarmStateStore
  [SupervisorReviewStore] as ReviewStore
  [A2ATaskStore] as TaskStore
}

cloud "LLM Providers" as LlmProviders

node "Downstream A2A Agents" {
  [Product Agent] as ProductAgent
  [Reservation Agent] as ReservationAgent
  [Search Agent] as SearchAgent
}

artifact "application.yml / a2a-supervisor-hitl.yml" as Config

Controller --> Validator
Controller --> Service
Service --> Idempotency
Service --> HitlPolicy
Service --> HitlDecision
Service --> Lifecycle
Service --> Orchestrator
Orchestrator --> GraphFactory
GraphFactory --> Planner
GraphFactory --> Invoker
GraphFactory --> HandoffPolicy
GraphFactory --> SwarmCoordinator
Orchestrator --> Composer
Composer --> A2uiService
Planner --> LlmRuntime
HitlPolicy --> LlmRuntime
Composer --> LlmRuntime
LlmRuntime --> ChatGateway
ChatGateway --> LlmProviders
Invoker --> Registry
Registry --> Config
Invoker --> A2AClient
A2AClient --> ProductAgent
A2AClient --> ReservationAgent
A2AClient --> SearchAgent
Orchestrator --> ConversationStore
Orchestrator --> CheckpointStore
SwarmCoordinator --> SwarmStateStore
HitlDecision --> ReviewStore
HitlDecision --> SwarmStateStore
Lifecycle --> TaskStore
Orchestrator --> ProgressSupport

note right of Service
HITL is enforced before graph execution.
WAITING_REVIEW requests do not enter orchestrator.
end note
@enduml
