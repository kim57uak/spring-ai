@startuml
!pragma layout smetana
title 07. Supervisor Agent Streaming Response Sequence

skinparam shadowing false

actor User
participant "SupervisorA2AController" as Controller
participant "SupervisorA2ARequestValidator" as Validator
participant "SupervisorAgentService" as Service
participant "HitlGateService" as HitlGate
participant "SupervisorStreamProgressService" as StreamProgress
participant "SupervisorExecutionService" as ExecutionService
participant "SupervisorAgentOrchestrator" as Orchestrator
participant "SupervisorProgressPublisher" as ProgressPublisher
participant "SupervisorResponseComposeService" as Composer
participant "DefaultSupervisorLlmRuntime" as Runtime
participant "SupervisorExecutionPersistenceService" as PersistenceService

User -> Controller : POST /a2a/supervisor\nAccept: text/event-stream
Controller -> Validator : precheck + validateSendParams
Validator --> Controller : message + model
Controller -> Service : streamEvents(sessionId, message, model)
Service -> StreamProgress : initialHitlEvaluationEvents(...)
Service --> Controller : SupervisorOutputEvent(PROGRESS)
Controller --> User : event: chunk

Service -> HitlGate : evaluate(...)
alt review required
  Service -> HitlGate : openReview(...)
  Service -> StreamProgress : hitlRequiredEvents(...)
  Service --> Controller : SupervisorOutputEvent(PROGRESS)
  Service --> Controller : SupervisorOutputEvent(PROGRESS)
  Controller --> User : event: chunk
  Controller --> User : event: chunk
  Controller --> User : event: done
else review not required
  Service -> StreamProgress : hitlPassedEvents(...)
  Service -> ExecutionService : executeStreamEvents(...)
  ExecutionService -> Orchestrator : executeEvents(...)
  Orchestrator -> ProgressPublisher : emitEvent(...)
  Orchestrator --> Controller : SupervisorOutputEvent(PROGRESS)
  Controller --> User : event: chunk

  Orchestrator -> Composer : streamComposeEvents(context)
  Composer -> Runtime : stream(prompt, model, sessionId)
  Runtime --> Composer : Flux<SupervisorOutputEvent>

  loop compose output
    alt text event
      Composer --> Orchestrator : SupervisorOutputEvent(TEXT)
      Orchestrator --> Controller : SupervisorOutputEvent(TEXT)
      Controller --> User : event: chunk
    else a2ui event
      Composer --> Orchestrator : SupervisorOutputEvent(A2UI)
      Orchestrator --> Controller : SupervisorOutputEvent(A2UI)
      Controller --> User : event: a2ui
    end
  end

  Orchestrator -> PersistenceService : persistCompletion(...)
  Orchestrator -> ProgressPublisher : emit completed progress
  Orchestrator --> Controller : SupervisorOutputEvent(PROGRESS)
  Controller --> User : event: chunk
  Controller --> User : event: done
end

note right of Controller
Current SSE framing
- event: chunk
- event: a2ui
- event: error
- event: done
end note
@enduml
