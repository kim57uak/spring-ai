@startuml
!pragma layout smetana
title 07. Supervisor Agent Streaming Response Sequence

skinparam shadowing false

actor User
participant "SupervisorA2AController" as Controller
participant "SupervisorA2ARequestValidator" as Validator
participant "SupervisorAgentService" as Service
participant "HitlPolicyService" as HitlPolicy
participant "SupervisorA2aLifecycleService" as Lifecycle
participant "HitlDecisionService" as HitlDecision
participant "SupervisorAgentOrchestrator" as Orchestrator
participant "SupervisorResponseComposeService" as Composer
participant "DefaultSupervisorLlmRuntime" as Runtime
participant "Conversation Store" as ConversationStore
participant "Checkpoint Store" as CheckpointStore

User -> Controller : POST /a2a/supervisor\nAccept: text/event-stream
Controller -> Validator : precheck + validateSendParams
Validator --> Controller : message + model
Controller -> Service : stream(sessionId, message, model)
Service --> Controller : progress(stage=hitl, 2%)
Controller --> User : event: chunk

Service -> HitlPolicy : evaluate(...)
alt review required
  Service -> Lifecycle : createAndMarkWaitingReview(...)
  Service -> HitlDecision : openReview(...)
  Service --> Controller : progress(stage=hitl, 5%)
  Service --> Controller : progress(stage=hitl_waiting, 8%)
  Controller --> User : event: chunk
  Controller --> User : event: chunk
  Controller --> User : event: done
else review not required
  Service -> Lifecycle : createAndMarkRunning(...)
  Service -> Orchestrator : execute(request, taskId)
  Orchestrator --> Controller : progress(initializing...)
  Controller --> User : event: chunk

  Orchestrator -> Composer : streamCompose(context)
  Composer -> Runtime : stream(prompt, model, sessionId)
  Runtime --> Composer : Flux<String>

  loop compose output
    alt plain text chunk
      Composer --> Orchestrator : chunk
      Orchestrator --> Controller : chunk
      Controller --> User : event: chunk
    else wrapped A2UI payload
      Composer --> Orchestrator : wrapped A2UI
      Orchestrator --> Controller : wrapped A2UI
      Controller --> User : event: a2ui
    end
  end

  Orchestrator -> ConversationStore : save history
  Orchestrator -> CheckpointStore : save checkpoint
  Orchestrator --> Controller : progress(completed...)
  Controller --> User : event: chunk
  Controller --> User : event: done
end

note right of Controller
Current SSE framing
- event: chunk
- event: a2ui
- event: error
- event: done
end note
@enduml
