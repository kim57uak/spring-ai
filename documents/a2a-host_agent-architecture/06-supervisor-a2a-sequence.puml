@startuml
!pragma layout smetana
title 06. Supervisor Agent A2A Routing Sequence

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 20

actor User
participant "SupervisorA2AController" as Controller
participant "SupervisorA2ARequestValidator" as Validator
participant "SupervisorAgentService" as Service
participant "HitlGateService" as HitlGate
participant "SupervisorReviewApplicationService" as ReviewApp
participant "SupervisorExecutionService" as ExecutionService
participant "SupervisorStreamProgressService" as StreamProgress
participant "SupervisorAgentOrchestrator" as Orchestrator
participant "SupervisorGraphExecutionService" as GraphExecution
participant "SupervisorExecutionSummaryEmitter" as SummaryEmitter
participant "SupervisorProgressPublisher" as ProgressPublisher
participant "SupervisorExecutionPersistenceService" as PersistenceService
participant "LangGraph CompiledGraph" as Graph
participant "SupervisorPlanningService\n<size:10><color:#7A5B00>CallLLM</color></size>" as Planner #FFE7A8
participant "DefaultSupervisorLlmRuntime" as Runtime #FFF4CC
participant "A2AInvocationService" as Invoker
participant "HandoffPolicyService" as HandoffPolicy
participant "SupervisorSwarmCoordinator" as Swarm
participant "A2AClientRegistry" as Registry
participant "A2AJsonRpcClient" as A2AClient
participant "SupervisorResponseComposeService\n<size:10><color:#7A5B00>CallLLM</color></size>" as Composer #FFE7A8
participant "Product Agent A2A" as ProductAgent
participant "Reservation Agent A2A" as ReservationAgent
participant "Search Agent A2A" as SearchAgent

User -> Controller : POST /a2a/supervisor\nmessage/send or message/stream
Controller -> Validator : precheck + validate params
Validator --> Controller : validated params
Controller -> Service : send(...) or streamEvents(...)
Service -> HitlGate : evaluate(sessionId, message, model)
HitlGate -> Runtime : complete(hitl policy prompt)\n<size:10><color:#7A5B00>CallLLM</color></size>
Runtime --> HitlGate : HitlPolicyResult

alt HITL required
  Service -> HitlGate : openReview(...)
  HitlGate -> Swarm : review facts/event update
  Service --> Controller : WAITING_REVIEW task or hitl_waiting progress
else HITL passed
  Service -> StreamProgress : initial/hitl-passed events
  Service -> ExecutionService : executeSync(...) or executeStreamEvents(...)
  ExecutionService -> Orchestrator : executeEvents(request, taskId)
  Orchestrator -> GraphExecution : execute(request, taskId, ...)
  GraphExecution -> Swarm : load latest session state
  GraphExecution -> Graph : invoke(state)

  Graph -> Planner : plan(context)
  Planner -> Runtime : complete(planning prompt)\n<size:10><color:#7A5B00>CallLLM</color></size>
  Runtime --> Planner : routing plans

  loop for selected routing batches
    Graph -> Invoker : invoke(plan, context)
    Invoker -> Registry : resolve(agentKey, method)
    Registry --> Invoker : endpoint/method/timeout
    Invoker -> A2AClient : call JSON-RPC / stream

    alt product route
      A2AClient -> ProductAgent : downstream A2A call
      ProductAgent --> A2AClient : result
    else reservation route
      A2AClient -> ReservationAgent : downstream A2A call
      ReservationAgent --> A2AClient : result
    else search route
      A2AClient -> SearchAgent : downstream A2A call
      SearchAgent --> A2AClient : result
    end

    Invoker --> Graph : DownstreamCallResult
    Graph -> Swarm : recordInvocationBatch(...)
    Graph -> HandoffPolicy : evaluate(context, batchResults)
    HandoffPolicy --> Graph : validations
    Graph -> Swarm : recordHandoffEvaluations(...)
  end

  Orchestrator -> SummaryEmitter : emit graph/routing summary
  Orchestrator -> Composer : streamComposeEvents(context)
  Composer -> Runtime : stream/complete(compose prompt)\n<size:10><color:#7A5B00>CallLLM</color></size>
  Runtime --> Composer : output events / A2UI decision
  Composer --> Orchestrator : SupervisorOutputEvent stream
  Orchestrator -> ProgressPublisher : progress/event log publish
  Orchestrator -> PersistenceService : persist completion / mark failed
  Orchestrator --> ExecutionService : SupervisorOutputEvent stream
  ExecutionService --> Service : task snapshot or event stream
  Service --> Controller : JSON-RPC or SupervisorOutputEvent SSE stream
end

alt review decide endpoint
  Controller -> Service : decideReview(...)
  Service -> ReviewApp : decideReview(...)
  ReviewApp -> HitlGate : decide(...)
  ReviewApp -> ExecutionService : resumeApprovedTask(...) when APPROVE
  ReviewApp --> Controller : task/review payload
end

Controller --> User : task response / chunk / a2ui / done

note right of HandoffPolicy
Current handoff guardrails
- feature flag
- route allowlist
- allowed methods only
- stream capability check
- max hops / recent path guard
- per-minute rate limit
end note
@enduml
