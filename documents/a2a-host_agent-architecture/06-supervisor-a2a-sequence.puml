@startuml
title 06. Supervisor A2A Request Sequence (Synced with Source, 2026-05-14)

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 20

actor User
participant "SupervisorA2AController" as Controller
participant "SupervisorA2ARequestValidator" as Validator
participant "SupervisorAgentService" as AgentService
participant "SupervisorRequestIdempotencyService" as Idempotency
participant "SupervisorPreHitlA2uiService" as PreHitlA2ui
participant "HitlGateService" as HitlGate
participant "SupervisorExecutionService" as ExecutionService
participant "SupervisorReviewApplicationService" as ReviewApp
participant "SupervisorTaskFacade" as TaskFacade
participant "SupervisorAgentOrchestrator" as Orchestrator
participant "SupervisorGraphExecutionService" as GraphExecution
participant "LangGraph CompiledGraph" as Graph
participant "A2AInvocationService" as Invoker
participant "SupervisorResponseComposeService" as Composer
participant "Downstream A2A Agents" as DownstreamAgents

User -> Controller : POST /a2a/supervisor
Controller -> Validator : precheck + validate params

alt unary send
  Controller -> AgentService : send(...)
  AgentService -> Idempotency : executeOnce(...)
  AgentService -> PreHitlA2ui : build(sessionId, message, model)

  alt pre-HITL A2UI resolved
    AgentService -> TaskFacade : createRunningTask(...)
    AgentService -> TaskFacade : markCompleted(...A2UI payload...)
    AgentService --> Controller : JSON-RPC TaskView
  else normal execution path
    AgentService -> HitlGate : evaluate(...)
    alt HITL required
      AgentService -> HitlGate : openReview(...)
      AgentService --> Controller : WAITING_REVIEW task
    else HITL passed
      AgentService -> ExecutionService : executeSync(...)
      ExecutionService -> TaskFacade : createRunningTask(...)
      ExecutionService -> Orchestrator : executeEvents(...)
      Orchestrator -> GraphExecution : execute(...)
      GraphExecution -> Graph : invoke(state)
      Graph -> Invoker : invoke(plan batch)
      Invoker -> DownstreamAgents : JSON-RPC / stream
      DownstreamAgents --> Invoker : downstream results
      Orchestrator -> Composer : streamComposeEvents(context)
      Composer --> Orchestrator : text / a2ui events
      ExecutionService -> TaskFacade : markCompleted(...)
      AgentService --> Controller : JSON-RPC TaskView
    end
  end
else stream request
  Controller -> AgentService : streamEvents(...)
  AgentService -> PreHitlA2ui : build(...)
  alt pre-HITL A2UI resolved
    AgentService --> Controller : progress + text + a2ui SSE
  else normal stream path
    AgentService -> HitlGate : evaluate(...)
    alt HITL required
      AgentService --> Controller : waiting review progress stream
    else HITL passed
      AgentService -> ExecutionService : executeStreamEvents(...)
      ExecutionService -> TaskFacade : createRunningTask(...)
      ExecutionService -> Orchestrator : executeEvents(...)
      Orchestrator -> GraphExecution : execute(...)
      GraphExecution -> Graph : invoke(state)
      Graph -> Invoker : invoke(plan batch)
      Invoker -> DownstreamAgents : JSON-RPC / stream
      DownstreamAgents --> Invoker : downstream results
      Orchestrator -> Composer : streamComposeEvents(context)
      Composer --> Controller : SupervisorOutputEvent SSE
    end
  end
else review endpoints
  Controller -> AgentService : getReview / decideReview / decideReviewStream
  AgentService -> ReviewApp : delegate review use case
  ReviewApp -> HitlGate : decide(...)
  ReviewApp -> ExecutionService : resumeApprovedTask / resumeApprovedTaskStream
  ReviewApp --> Controller : review/task payload or stream
end

Controller --> User : JSON-RPC or SSE(chunk/a2ui/done)

@enduml
