@startuml
!pragma layout smetana
title 02. Supervisor Agent Package Policy (com.example.springsupervisorai)

skinparam shadowing false
skinparam packageStyle rectangle

package "com.example.springsupervisorai" {
  package "config" {
    class A2aSupervisorRoutingProperties
    class SupervisorPromptProperties
    class SupervisorStreamProperties
  }

  package "controller" {
    class SupervisorA2AController
    class SupervisorA2ARequestValidator
  }

  package "service" {
    class SupervisorAgentService
    class SupervisorAgentOrchestrator
    class SupervisorProgressSupport
  }

  package "service.agent" {
    package "plan" {
      interface SupervisorPlanningService
      class LlmSupervisorPlanningService
    }
    package "invoke" {
      interface A2AInvocationService
      class DefaultA2AInvocationService
      class A2AClientRegistry
      class DownstreamAgentCardCache
    }
    package "handoff" {
      interface HandoffPolicyService
      class DefaultHandoffPolicyService
    }
    package "compose" {
      interface SupervisorResponseComposeService
      class LlmSupervisorResponseComposeService
    }
    package "graph" {
      interface SupervisorStateGraphFactory
      class LangGraphSupervisorStateGraphFactory
    }
    package "hitl" {
      interface HitlPolicyService
      class LlmHitlPolicyService
      interface HitlDecisionService
      class DefaultHitlDecisionService
    }
    package "swarm" {
      interface SupervisorSwarmCoordinator
      class DefaultSupervisorSwarmCoordinator
    }
    package "a2ui" {
      interface SupervisorA2uiService
      interface A2uiComposePromptProvider
    }
    package "runtime" {
      interface SupervisorLlmRuntime
      class DefaultSupervisorLlmRuntime
      interface SupervisorChatGateway
      class ReflectionSupervisorChatGateway
    }
    package "store" {
      interface ConversationStore
      interface GraphCheckpointStore
      interface SupervisorSwarmStateStore
      interface SupervisorReviewStore
    }
  }

  package "a2a" {
    class A2AJsonRpcClient
    class A2ARequestMapper
    class A2AResponseMapper
  }

  package "a2a.lifecycle" {
    class SupervisorA2aLifecycleService
  }

  package "a2a.idempotency" {
    class SupervisorRequestIdempotencyService
  }

  package "model" {
    class SupervisorAgentRequest
    class SupervisorPlanningContext
    class SwarmState
    class HitlPolicyResult
    class HitlReviewTicket
    class RoutingPlan
    class DownstreamCallResult
    class HandoffDirective
    class HandoffValidationResult
    class SupervisorGraphState
    class SupervisorRuntimeState
  }

  package "exception" {
    class A2ARoutingException
    class DownstreamA2AException
    class SupervisorChatProcessingException
  }
}

note bottom
Rules
- Controller는 JSON-RPC/SSE 입구와 params 검증만 담당한다
- Service는 HITL pre-gate, task lifecycle, idempotency를 담당한다
- Orchestrator는 graph 실행과 persistence coordination을 담당한다
- Graph 내부에서 planning/invoke/handoff를 수행하고 compose는 graph 외부에서 수행한다
- 하위 agent 연동은 오직 A2A(JSON-RPC/SSE) 경계로 처리한다
- A2UI는 compose 결과 이후 선택적으로 부착된다
- Swarm coordinator는 store 직접 노출 대신 rule/event mutation을 캡슐화한다
end note
@enduml
