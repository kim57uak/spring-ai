@startuml
!pragma layout smetana
title 04. Supervisor Agent Domain Class Model

skinparam shadowing false
skinparam classAttributeIconSize 0

class SupervisorAgentRequest {
  +sessionId: String
  +message: String
  +model: String
}

class SupervisorPlanningContext {
  +sessionId: String
  +userMessage: String
  +model: String
  +history: List<String>
  +routingPlans: List<RoutingPlan>
  +results: List<DownstreamCallResult>
  +checkpointId: String
  +hitlRequired: boolean
  +hitlStatus: String
  +swarmStateVersion: long
}

class SwarmSharedState {
  +stateVersion: long
  +sharedFacts: Map<String, Object>
  +eventLog: List<Map<String, Object>>
}

class HitlReviewContext {
  +required: boolean
  +decision: String
  +decisionReason: String
  +expiresAt: Instant
}

class RoutingPlan {
  +agentKey: String
  +method: String
  +reason: String
  +priority: int
  +arguments: Map<String, Object>
  +sourceType: String  ' PLANNER | HANDOFF
  +handoffDepth: int
  +parentAgentKey: String
}

class DownstreamCallResult {
  +agentKey: String
  +taskId: String
  +status: String
  +payload: String
  +errorCode: String
  +errorMessage: String
  +handoffRequested: boolean
  +nextAgentKey: String
  +handoffMethod: String
  +handoffReason: String
  +handoffArguments: Map<String, Object>
}

class HandoffDirective {
  +nextAgentKey: String
  +method: String
  +reason: String
  +arguments: Map<String, Object>
}

class HandoffValidationResult {
  +accepted: boolean
  +rejectReason: String
  +hopCount: int
}

class SupervisorGraphState {
  +SESSION_ID
  +USER_MESSAGE
  +MODEL
  +HISTORY
  +ROUTING_PLANS
  +DOWNSTREAM_RESULTS
  +CURRENT_NODE
}

interface SupervisorPlanningService {
  +plan(context): List<RoutingPlan>
}

interface A2AInvocationService {
  +invoke(plan, context): DownstreamCallResult
}

interface HandoffPolicyService {
  +evaluate(result, context): HandoffValidationResult
}

interface SupervisorResponseComposeService {
  +streamCompose(context): Flux<String>
}

SupervisorAgentRequest --> SupervisorPlanningContext
SupervisorPlanningContext --> RoutingPlan
SupervisorPlanningContext --> DownstreamCallResult
DownstreamCallResult --> HandoffDirective
SupervisorPlanningContext --> HandoffValidationResult
SupervisorPlanningContext --> SwarmSharedState
SupervisorPlanningContext --> HitlReviewContext
SupervisorGraphState --> SupervisorPlanningContext

' 2026-04-13 sync with doc 34
' - add handoff domain objects and routing/result extensions
' - handoff is feature-flagged and validated by policy service
' 2026-04-12 sync with docs 30/31
' - Scope: HITL decision limited to APPROVE/CANCEL in current phase
' - Data mutation requests (create/update/delete) require mandatory HITL
' - A2A compatibility mode keeps both legacy and v1.0 methods
' - User profile input collection is deferred to next phase
@enduml
