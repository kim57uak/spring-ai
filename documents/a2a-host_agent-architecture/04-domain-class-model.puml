@startuml
!pragma layout smetana
title 04. Supervisor Agent Domain Class Model

skinparam shadowing false
skinparam classAttributeIconSize 0

class SupervisorAgentRequest {
  +sessionId: String
  +message: String
  +model: String
}

class SupervisorPlanningContext {
  +taskId: String
  +sessionId: String
  +userMessage: String
  +model: String
  +history: List<String>
  +routingPlans: List<RoutingPlan>
  +results: List<DownstreamCallResult>
  +checkpointId: String
  +currentNode: String
  +routingIndex: int
  +swarmStateVersion: long
  +swarmSharedFacts: Map<String, Object>
}

class SwarmState {
  +taskId: String
  +sessionId: String
  +stateVersion: long
  +updatedAt: Instant
  +sharedFacts: Map<String, Object>
  +eventLog: List<Map<String, Object>>
}

class HitlPolicyResult {
  +required: boolean
  +policyId: String
  +reason: String
}

class HitlReviewTicket {
  +taskId: String
  +sessionId: String
  +message: String
  +model: String
  +policyId: String
  +policyReason: String
  +status: HitlReviewStatus
  +decisionReason: String
  +requestedAt: Instant
  +expiresAt: Instant
  +decidedAt: Instant
  +decisionId: String
}

class RoutingPlan {
  +agentKey: String
  +method: String
  +reason: String
  +priority: int
  +arguments: Map<String, Object>
  +sourceType: String
  +handoffDepth: int
  +parentAgentKey: String
}

class DownstreamCallResult {
  +agentKey: String
  +taskId: String
  +status: String
  +payload: String
  +errorCode: String
  +errorMessage: String
  +handoffRequested: boolean
  +nextAgentKey: String
  +handoffMethod: String
  +handoffReason: String
  +handoffArguments: Map<String, Object>
}

class HandoffDirective {
  +fromAgentKey: String
  +nextAgentKey: String
  +method: String
  +reason: String
  +arguments: Map<String, Object>
}

class HandoffValidationResult {
  +accepted: boolean
  +reasonCode: String
  +directive: HandoffDirective
  +plan: RoutingPlan
  +hopCount: int
}

class SupervisorGraphState {
  +SESSION_ID
  +TASK_ID
  +USER_MESSAGE
  +MODEL
  +HISTORY
  +CHECKPOINT_ID
  +CURRENT_NODE
  +ROUTING_PLANS
  +ROUTING_INDEX
  +CURRENT_PLAN
  +DOWNSTREAM_RESULTS
  +LAST_INVOKE_BATCH_RESULTS
  +HANDOFF_VALIDATIONS
  +HANDOFF_ENABLED
  +SWARM_SHARED_FACTS
  +SWARM_STATE_VERSION
}

interface HitlPolicyService {
  +evaluate(sessionId, message, model): HitlPolicyResult
}

interface HitlDecisionService {
  +openReview(taskId, sessionId, message, model, policy): HitlReviewTicket
  +decide(taskId, sessionId, decision, reason, decisionId): Optional<HitlReviewTicket>
}

interface SupervisorPlanningService {
  +plan(context): List<RoutingPlan>
}

interface A2AInvocationService {
  +invoke(plan, context): DownstreamCallResult
}

interface HandoffPolicyService {
  +evaluate(context, batchResults): List<HandoffValidationResult>
}

interface SupervisorResponseComposeService {
  +streamCompose(context): Flux<String>
}

SupervisorAgentRequest --> SupervisorPlanningContext
SupervisorPlanningContext --> RoutingPlan
SupervisorPlanningContext --> DownstreamCallResult
SupervisorPlanningContext --> SwarmState
DownstreamCallResult --> HandoffDirective
HandoffValidationResult --> HandoffDirective
HandoffValidationResult --> RoutingPlan
SupervisorGraphState --> SupervisorPlanningContext
HitlPolicyService --> HitlPolicyResult
HitlDecisionService --> HitlReviewTicket
@enduml
