@startuml
title 04. Supervisor Host Agent Domain Model (Current Source, 2026-04-18)

skinparam shadowing false
skinparam classAttributeIconSize 0

class SupervisorAgentRequest {
  +sessionId: String
  +message: String
  +model: String
}

class SupervisorExecutionRequest {
  +sessionId: String
  +message: String
  +model: String
}

class SupervisorPlanningContext {
  +taskId: String
  +sessionId: String
  +userMessage: String
  +model: String
  +history: List<String>
  +routingPlans: List<RoutingPlan>
  +results: List<DownstreamCallResult>
  +routingIndex: int
  +swarmStateVersion: long
  +swarmSharedFacts: Map<String, Object>
  +currentNode: String
  +checkpointId: String
}

class RoutingPlan {
  +agentKey: String
  +method: String
  +reason: String
  +priority: int
  +arguments: Map<String, Object>
}

class DownstreamCallResult {
  +agentKey: String
  +taskId: String
  +status: String
  +payload: String
  +errorCode: String
  +errorMessage: String
  +handoffRequested: boolean
  +nextAgentKey: String
  +handoffMethod: String
  +handoffReason: String
  +handoffArguments: Map<String, Object>
}

class HitlPolicyResult {
  +required: boolean
  +policyId: String
  +reason: String
}

class HitlReviewTicket {
  +taskId: String
  +sessionId: String
  +message: String
  +model: String
  +policyId: String
  +policyReason: String
  +status: HitlReviewStatus
  +decisionReason: String
  +decisionId: String
}

class SwarmState {
  +taskId: String
  +sessionId: String
  +stateVersion: long
  +updatedAt: Instant
  +sharedFacts: Map<String, Object>
  +eventLog: List<Map<String, Object>>
}

class HandoffDirective {
  +fromAgentKey: String
  +nextAgentKey: String
  +method: String
  +reason: String
  +arguments: Map<String, Object>
}

class HandoffValidationResult {
  +accepted: boolean
  +reasonCode: String
  +directive: HandoffDirective
  +plan: RoutingPlan
  +hopCount: int
}

class InvocationPolicyContext {
  +plan: RoutingPlan
  +planningContext: SupervisorPlanningContext
}

class HitlPolicyContext {
  +sessionId: String
  +message: String
  +model: String
}

class HandoffPolicyContext {
  +planningContext: SupervisorPlanningContext
  +batchResults: List<DownstreamCallResult>
}

class SupervisorOutputEvent {
  +type: SupervisorOutputEventType
  +content: String
}

class SupervisorGraphState {
  +SESSION_ID
  +TASK_ID
  +USER_MESSAGE
  +MODEL
  +HISTORY
  +CHECKPOINT_ID
  +CURRENT_NODE
  +ROUTING_PLANS
  +ROUTING_INDEX
  +CURRENT_PLAN
  +DOWNSTREAM_RESULTS
  +LAST_INVOKE_BATCH_RESULTS
  +HANDOFF_VALIDATIONS
  +HANDOFF_ENABLED
  +SWARM_SHARED_FACTS
  +SWARM_STATE_VERSION
}

class A2aTaskSnapshot {
  +taskId: String
  +sessionId: String
  +status: A2aTaskStatus
  +requestMessage: String
  +responsePayload: String
  +errorCode: String
  +errorMessage: String
}

enum A2aTaskStatus {
  SUBMITTED
  RUNNING
  WAITING_REVIEW
  COMPLETED
  FAILED
  CANCELED
}

interface SupervisorPlanningService {
  +plan(context): List<RoutingPlan>
}

interface HitlPolicyService {
  +evaluate(context): HitlPolicyResult
}

interface HitlDecisionService {
  +openReview(...): HitlReviewTicket
  +getReview(...): Optional<HitlReviewTicket>
  +decide(...): Optional<HitlReviewTicket>
}

interface A2AInvocationService {
  +invoke(context): DownstreamCallResult
}

interface HandoffPolicyService {
  +evaluate(context): List<HandoffValidationResult>
}

interface SupervisorResponseComposeService {
  +streamComposeEvents(context): Flux<SupervisorOutputEvent>
}

interface SupervisorSwarmCoordinator {
  +applyRoutingRule(...): List<RoutingPlan>
  +loadLatestBySession(sessionId): Optional<SwarmState>
}

SupervisorAgentRequest --> SupervisorPlanningContext
SupervisorExecutionRequest --> SupervisorAgentRequest
SupervisorPlanningContext --> RoutingPlan
SupervisorPlanningContext --> DownstreamCallResult
SupervisorPlanningContext --> SwarmState
SupervisorPlanningContext --> SupervisorGraphState
DownstreamCallResult --> HandoffDirective
HandoffValidationResult --> HandoffDirective
HandoffValidationResult --> RoutingPlan
InvocationPolicyContext --> RoutingPlan
InvocationPolicyContext --> SupervisorPlanningContext
HandoffPolicyContext --> SupervisorPlanningContext
HandoffPolicyContext --> DownstreamCallResult
HitlPolicyService --> HitlPolicyResult
HitlDecisionService --> HitlReviewTicket
SupervisorResponseComposeService --> SupervisorOutputEvent

note bottom of SupervisorPlanningContext
Current shared runtime state for:
- planning
- invoke/handoff
- compose
- swarm facts
- checkpoint recovery
end note

@enduml
