@startuml
!pragma layout smetana
title 03. A2A Supervisor Agent Component Architecture

skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho

package "01 Entry" {
  [SupervisorA2A\nController] as Controller
  [SupervisorA2ARequest\nValidator] as Validator
  [GlobalException\nHandler] as Advice
}

package "02 Application" {
  [SupervisorAgent\nService] as Service
  [SupervisorAgent\nOrchestrator] as Orchestrator
  [SupervisorReviewApplication\nService] as ReviewApp
  [SupervisorExecution\nService] as ExecutionService
  [SupervisorExecutionResult\nCollector] as ResultCollector
  [SupervisorStreamProgress\nService] as StreamProgress
  [SupervisorExecutionSummary\nEmitter] as SummaryEmitter
  [SupervisorGraphExecution\nService] as GraphExecution
  [SupervisorExecutionPersistence\nService] as PersistenceService
  [SupervisorFallbackInvoke\nService] as FallbackService
  [SupervisorGraphInput\nBuilder] as GraphInputBuilder
  [SupervisorHandoffProgress\nSupport] as HandoffProgressSupport
  [SupervisorProgress\nPublisher] as ProgressPublisher
  [SupervisorA2aLifecycle\nService] as Lifecycle
  [SupervisorRequestIdempotency\nService] as Idempotency
}

package "03 Usecase Ports" {
  interface "HITL Policy\nPort" as HitlPolicyPort
  interface "HITL Decision\nPort" as HitlDecisionPort
  interface "Planning\nPort" as PlanningPort
  interface "Invocation\nPort" as InvocationPort
  interface "Handoff Policy\nPort" as HandoffPolicyPort
  interface "Compose\nPort" as ComposePort
  interface "Graph Factory\nPort" as GraphFactoryPort
  interface "Swarm Coordinator\nPort" as SwarmCoordinatorPort
}

package "04 Infra Ports" {
  interface "Conversation Store\nPort" as ConversationStorePort
  interface "Checkpoint Store\nPort" as CheckpointStorePort
  interface "Swarm State Store\nPort" as SwarmStateStorePort
  interface "Review Store\nPort" as ReviewStorePort
  interface "Task Store\nPort" as TaskStorePort
}

package "05 Adapters" {
  [LlmHitlPolicy\nService\n<size:10><color:#7A5B00>CallLLM</color></size>] as HitlPolicyImpl #FFE7A8
  [DefaultHitlDecision\nService] as HitlDecisionImpl
  [LlmSupervisorPlanning\nService\n<size:10><color:#7A5B00>CallLLM</color></size>] as PlanningImpl #FFE7A8
  [DefaultA2A\nInvocationService] as InvocationImpl
  [DefaultHandoff\nPolicyService] as HandoffImpl
  [LangGraphSupervisor\nStateGraphFactory] as GraphFactoryImpl
  [DefaultSupervisorSwarm\nCoordinator] as SwarmCoordinatorImpl
  [LlmSupervisorResponse\nComposeService\n<size:10><color:#7A5B00>CallLLM</color></size>] as ComposeImpl #FFE7A8
  [DefaultSupervisorProductInfo\nA2uiService] as A2uiImpl
  [RedisConversationStore /\nInMemory impl] as ConversationStoreImpl
  [RedisGraphCheckpointStore] as CheckpointStoreImpl
  [RedisSupervisorSwarmStateStore /\nInMemory impl] as SwarmStateStoreImpl
  [RedisSupervisorReviewStore /\nInMemory impl] as ReviewStoreImpl
  [RedisA2ATaskStore /\nInMemory impl] as TaskStoreImpl
}

package "06 Runtime / External" {
  [DefaultSupervisor\nLlmRuntime\n<size:10><color:#7A5B00>CallLLM</color></size>] as LlmRuntime #FFF4CC
  [A2AClient\nRegistry] as Registry
  [A2AJsonRpc\nClient] as JsonRpcClient
  [application.yml /\na2a-supervisor-hitl.yml] as Config
  [Downstream A2A\nAgents] as Agents
}

Controller --> Validator : params/schema check
Controller --> Service : send/stream/tasks
Controller --> Advice : exception mapping

Service --> Idempotency : send only
Service --> StreamProgress : stream preface / hitl progress
Service --> ReviewApp : review decide
Service --> HitlPolicyPort : evaluate pre-gate via HitlGateService
Service --> HitlDecisionPort : open/get/decide via HitlGateService
Service --> ExecutionService : execute when allowed

ReviewApp --> HitlDecisionPort : decide review
ReviewApp --> ExecutionService : resume approved task
ReviewApp --> Lifecycle : task view lookup/update

ExecutionService --> Lifecycle : create/update task
ExecutionService --> Orchestrator : executeEvents(...)
ExecutionService --> ResultCollector : sync/resume payload collect
ExecutionService --> ProgressPublisher : cancel path / task context

Orchestrator --> GraphExecution : load state + invoke graph
Orchestrator --> SummaryEmitter : graph/routing/invocation summary
Orchestrator --> PersistenceService : completion / clear session
Orchestrator --> FallbackService : invoke when graph result empty
Orchestrator --> ProgressPublisher : structured progress/event publish
Orchestrator --> ComposePort : final response compose
Orchestrator --> Lifecycle : canceled status check

GraphExecution --> GraphFactoryPort : compiled graph
GraphExecution --> ConversationStorePort : history load
GraphExecution --> CheckpointStorePort : checkpoint load
GraphExecution --> SwarmCoordinatorPort : latest swarm load
GraphExecution --> GraphInputBuilder : build typed input

PersistenceService --> ConversationStorePort : history save
PersistenceService --> CheckpointStorePort : checkpoint save/clear
PersistenceService --> Lifecycle : mark completed/failed

SummaryEmitter --> HandoffProgressSupport : handoff metadata

GraphFactoryPort <|.. GraphFactoryImpl
GraphFactoryImpl --> PlanningPort
GraphFactoryImpl --> InvocationPort
GraphFactoryImpl --> HandoffPolicyPort
GraphFactoryImpl --> SwarmCoordinatorPort

HitlPolicyPort <|.. HitlPolicyImpl
HitlDecisionPort <|.. HitlDecisionImpl
PlanningPort <|.. PlanningImpl
InvocationPort <|.. InvocationImpl
HandoffPolicyPort <|.. HandoffImpl
ComposePort <|.. ComposeImpl
SwarmCoordinatorPort <|.. SwarmCoordinatorImpl

ConversationStorePort <|.. ConversationStoreImpl
CheckpointStorePort <|.. CheckpointStoreImpl
SwarmStateStorePort <|.. SwarmStateStoreImpl
ReviewStorePort <|.. ReviewStoreImpl
TaskStorePort <|.. TaskStoreImpl

HitlPolicyImpl --> LlmRuntime
PlanningImpl --> LlmRuntime
ComposeImpl --> LlmRuntime
ComposeImpl --> A2uiImpl
InvocationImpl --> Registry
InvocationImpl --> JsonRpcClient
Registry --> Config
JsonRpcClient --> Agents
SwarmCoordinatorImpl --> SwarmStateStorePort
HitlDecisionImpl --> ReviewStorePort
HitlDecisionImpl --> SwarmStateStorePort
Lifecycle --> TaskStorePort

note right of Service
Current application split
- Service: use case dispatch + response mapping
- ExecutionService: send/stream/resume execution boundary
- ReviewApp: approve/cancel review use case
- Orchestrator: graph/compose/cancel coordination
end note

note right of GraphFactoryImpl
Current graph nodes
- plan
- select
- invoke
- handoff_evaluate
- handoff_apply
- merge
- compose
end note
@enduml
