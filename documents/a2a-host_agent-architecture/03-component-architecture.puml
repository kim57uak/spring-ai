@startuml
!pragma layout smetana
title 03. A2A Supervisor Agent Component Architecture

skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho

package "01 Entry" {
  [SupervisorA2A\nController] as SupervisorA2AController
  [GlobalException\nHandler] as Advice
}

package "02 Application" {
  [SupervisorAgent\nService] as SupervisorService
  [SupervisorAgent\nOrchestrator] as SupervisorOrchestrator
}

package "03-1 Usecase Ports (Contracts)" {
  interface "Planning\nPort" as PlanningPort
  interface "Invocation\nPort" as InvocationPort
  interface "Handoff Policy\nPort" as HandoffPolicyPort
  interface "Compose\nPort" as ComposePort
  interface "HITL Policy\nPort" as HitlPolicyPort
  interface "HITL Decision\nPort" as HitlDecisionPort
}

package "03-2 Infra Ports (Contracts)" {
  interface "Graph Factory\nPort" as GraphFactoryPort
  interface "Conversation Store\nPort" as ConversationStorePort
  interface "Checkpoint Store\nPort" as CheckpointStorePort
  interface "Swarm State Store\nPort" as SwarmStateStorePort
}

package "04 Adapters (Implementations)" {
  package "04-1 Usecase Adapters" {
    [LlmSupervisor\nPlanningService\n<size:10><color:#7A5B00>CallLLM</color></size>] as PlanningImpl #FFE7A8
    [DefaultA2A\nInvocationService] as InvocationImpl
    [DefaultHandoff\nPolicyService] as HandoffPolicyImpl
    [LlmSupervisorResponse\nComposeService\n<size:10><color:#7A5B00>CallLLM</color></size>] as ComposeImpl #FFE7A8
    [DefaultHitl\nPolicyService] as HitlPolicyImpl
    [DefaultHitl\nDecisionService] as HitlDecisionImpl
  }

  package "04-2 Infra Adapters" {
    [LangGraphSupervisor\nStateGraphFactory] as GraphFactoryImpl
    [RedisConversation\nStore] as ConversationStoreImpl
    [RedisGraphCheckpoint\nStore] as CheckpointStoreImpl
    [RedisSupervisor\nSwarmStateStore] as SwarmStateStoreImpl
  }

  package "04-3 A2A Gateway" {
    [A2AClient\nRegistry] as A2ARegistry
    [A2AJsonRpc\nClient] as A2AJsonRpcClient
  }
}

package "05 Runtime / External" {
  [SupervisorProgress\nSupport] as ProgressSupport
  [DefaultSupervisor\nLlmRuntime\n<size:10><color:#7A5B00>CallLLM</color></size>] as LlmRuntime #FFF4CC
  [ModelChatService\nFactory] as ChatFactory
  [LlmCallPolicy] as LlmPolicy
  [a2a-supervisor.yml] as SupervisorConfig
  [Product Agent\nA2A] as ProductAgent
  [Reservation Agent\nA2A] as ReservationAgent
  [Search Agent\nA2A] as SearchAgent
}

SupervisorA2AController --> SupervisorService : request
SupervisorA2AController --> Advice : exception mapping
SupervisorService --> SupervisorOrchestrator : orchestrate

SupervisorOrchestrator --> PlanningPort : intent plan
SupervisorOrchestrator --> InvocationPort : downstream call
SupervisorOrchestrator --> HandoffPolicyPort : evaluate/apply handoff
SupervisorOrchestrator --> ComposePort : response compose
SupervisorOrchestrator --> HitlPolicyPort : risk evaluate
SupervisorOrchestrator --> HitlDecisionPort : approve/cancel apply
SupervisorOrchestrator --> GraphFactoryPort : state graph
SupervisorOrchestrator --> ConversationStorePort : history load/save
SupervisorOrchestrator --> CheckpointStorePort : checkpoint load/save
SupervisorOrchestrator --> SwarmStateStorePort : shared state load/save
SupervisorOrchestrator --> ProgressSupport : trace/progress emit

note right of ComposePort
Usecase mappings
- PlanningPort -> SupervisorPlanningService
- InvocationPort -> A2AInvocationService
- ComposePort -> SupervisorResponseComposeService
end note

note right of CheckpointStorePort
Infra mappings
- GraphFactoryPort -> SupervisorStateGraphFactory
- ConversationStorePort -> ConversationStore
- CheckpointStorePort -> GraphCheckpointStore
end note

PlanningPort <|.. PlanningImpl
InvocationPort <|.. InvocationImpl
HandoffPolicyPort <|.. HandoffPolicyImpl
ComposePort <|.. ComposeImpl
HitlPolicyPort <|.. HitlPolicyImpl
HitlDecisionPort <|.. HitlDecisionImpl
GraphFactoryPort <|.. GraphFactoryImpl
ConversationStorePort <|.. ConversationStoreImpl
CheckpointStorePort <|.. CheckpointStoreImpl
SwarmStateStorePort <|.. SwarmStateStoreImpl

PlanningImpl --> LlmRuntime
ComposeImpl --> LlmRuntime
LlmRuntime --> ChatFactory
ChatFactory --> LlmPolicy

InvocationImpl --> A2ARegistry : resolve route
InvocationImpl --> A2AJsonRpcClient : call json-rpc
A2ARegistry --> SupervisorConfig : route config
A2AJsonRpcClient --> ProductAgent
A2AJsonRpcClient --> ReservationAgent
A2AJsonRpcClient --> SearchAgent

note bottom of InvocationImpl
Supervisor boundary rule
- no sub-agent internal dependency
- A2A endpoint allowlist + timeout/retry
- handoff method must be allowed enum only
- stream handoff blocked for non-stream-capable agent
end note

