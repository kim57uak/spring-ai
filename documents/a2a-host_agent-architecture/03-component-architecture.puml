@startuml
title 03. Supervisor Host Agent Component Architecture (Current Source, 2026-05-11)

skinparam shadowing false
skinparam componentStyle rectangle

package "entry" {
  [SupervisorA2AController\n/a2a/supervisor] as Controller
  [SupervisorA2ARequestValidator] as Validator
}

package "application services" {
  [SupervisorAgentService] as AgentService
  [SupervisorPreHitlA2uiService] as PreHitlA2uiService
  [HitlGateService] as HitlGateService
  [SupervisorExecutionService] as ExecutionService
  [SupervisorReviewApplicationService] as ReviewAppService
  [SupervisorStreamProgressService] as StreamProgressService
  [SupervisorTaskFacade] as TaskFacade
  [SupervisorAgentOrchestrator] as Orchestrator
  [SupervisorGraphExecutionService] as GraphExecutionService
  [SupervisorGraphInputBuilder] as GraphInputBuilder
  [SupervisorExecutionPersistenceService] as PersistenceService
  [SupervisorExecutionResultCollector] as ResultCollector
  [SupervisorExecutionStateLoader] as StateLoader
  [SupervisorExecutionSummaryEmitter] as SummaryEmitter
  [SupervisorFallbackInvokeService] as FallbackInvokeService
  [SupervisorExceptionTranslator] as ExceptionTranslator
  [SupervisorProgressPublisher] as ProgressPublisher
  [SupervisorOutputEventSupport] as OutputEventSupport
  [SupervisorHandoffProgressSupport] as HandoffProgressSupport
}

package "supervisor ports" {
  [SupervisorPlanningService] <<port>> as PlanningPort
  [HitlPolicyService] <<port>> as HitlPolicyPort
  [HitlDecisionService] <<port>> as HitlDecisionPort
  [A2AInvocationService] <<port>> as InvocationPort
  [HandoffPolicyService] <<port>> as HandoffPolicyPort
  [SupervisorResponseComposeService] <<port>> as ComposePort
  [SupervisorStateGraphFactory] <<port>> as GraphFactoryPort
  [SupervisorSwarmCoordinator] <<port>> as SwarmCoordinatorPort
  [SupervisorA2uiService] <<port>> as A2uiPort
}

package "storage ports" {
  [ConversationStore] <<port>> as ConversationStorePort
  [GraphCheckpointStore] <<port>> as CheckpointStorePort
  [SupervisorSwarmStateStore] <<port>> as SwarmStateStorePort
  [SupervisorReviewStore] <<port>> as ReviewStorePort
  [A2ATaskStore] <<port>> as TaskStorePort
}

package "implementations" {
  [LlmSupervisorPlanningService] as PlanningImpl
  [LlmHitlPolicyService] as HitlPolicyImpl
  [DefaultHitlDecisionService] as HitlDecisionImpl
  [DefaultA2AInvocationService] as InvocationImpl
  [DefaultHandoffPolicyService] as HandoffImpl
  [LlmSupervisorResponseComposeService] as ComposeImpl
  [LangGraphSupervisorStateGraphFactory] as GraphFactoryImpl
  [DefaultSupervisorSwarmCoordinator] as SwarmCoordinatorImpl
  [SupervisorPlanRunner] as PlanRunner
  [CompositeSupervisorA2uiService] as CompositeA2uiService
  [DefaultSupervisorProductInfoA2uiService] as ProductA2uiService
  [DefaultSupervisorReservationA2uiService] as ReservationA2uiService
  [RedisConversationStore] as ConversationStoreImpl
  [RedisGraphCheckpointStore] as CheckpointStoreImpl
  [RedisSupervisorSwarmStateStore] as SwarmStateStoreImpl
  [RedisSupervisorReviewStore] as ReviewStoreImpl
  [RedisA2ATaskStore] as RedisTaskStore
  [InMemoryA2ATaskStore] as InMemoryTaskStore
}

package "runtime / integration" {
  [DefaultSupervisorLlmRuntime] as LlmRuntime
  [SupervisorChatGateway] <<port>> as ChatGatewayPort
  [ReflectionSupervisorChatGateway] as ChatGatewayImpl
  [A2AClientRegistry] as ClientRegistry
  [A2ARequestMapper] as RequestMapper
  [A2AJsonRpcClient] as JsonRpcClient
  [SupervisorA2aLifecycleService] as LifecycleService
  [SupervisorRequestIdempotencyService] as IdempotencyService
  [SupervisorPromptRenderService] as PromptRenderService
  [application.yml /\na2a-supervisor-hitl.yml] as Config
  [Downstream A2A Agents] as DownstreamAgents
}

Controller --> Validator
Controller --> AgentService
Controller --> OutputEventSupport

AgentService --> PreHitlA2uiService
AgentService --> HitlGateService
AgentService --> ExecutionService
AgentService --> ReviewAppService
AgentService --> StreamProgressService
AgentService --> TaskFacade
AgentService --> IdempotencyService

PreHitlA2uiService --> PlanningPort
PreHitlA2uiService --> StateLoader
PreHitlA2uiService --> SwarmCoordinatorPort
PreHitlA2uiService --> A2uiPort

HitlGateService --> HitlPolicyPort
HitlGateService --> HitlDecisionPort
HitlGateService --> TaskFacade

ExecutionService --> Orchestrator
ExecutionService --> TaskFacade
ExecutionService --> ResultCollector

GraphExecutionService --> GraphInputBuilder
Orchestrator --> HandoffProgressSupport
SummaryEmitter --> HandoffProgressSupport

ReviewAppService --> HitlGateService
ReviewAppService --> ExecutionService
ReviewAppService --> TaskFacade

TaskFacade --> LifecycleService
LifecycleService --> TaskStorePort

Orchestrator --> GraphExecutionService
Orchestrator --> ComposePort
Orchestrator --> ProgressPublisher
Orchestrator --> PersistenceService
Orchestrator --> FallbackInvokeService
Orchestrator --> ExceptionTranslator
Orchestrator --> SummaryEmitter
Orchestrator --> LifecycleService

GraphExecutionService --> StateLoader
GraphExecutionService --> GraphFactoryPort
GraphExecutionService --> ProgressPublisher
StateLoader --> ConversationStorePort
StateLoader --> CheckpointStorePort
StateLoader --> SwarmCoordinatorPort

GraphFactoryImpl ..> GraphFactoryPort : implements
PlanningImpl ..> PlanningPort : implements
HitlPolicyImpl ..> HitlPolicyPort : implements
HitlDecisionImpl ..> HitlDecisionPort : implements
InvocationImpl ..> InvocationPort : implements
HandoffImpl ..> HandoffPolicyPort : implements
ComposeImpl ..> ComposePort : implements
SwarmCoordinatorImpl ..> SwarmCoordinatorPort : implements
CompositeA2uiService ..> A2uiPort : implements

GraphFactoryImpl --> PlanningPort
GraphFactoryImpl --> HandoffPolicyPort
GraphFactoryImpl --> SwarmCoordinatorPort
GraphFactoryImpl --> ProgressPublisher

PlanningImpl --> LlmRuntime
HitlPolicyImpl --> LlmRuntime
ComposeImpl --> LlmRuntime
ComposeImpl --> A2uiPort
InvocationImpl --> ClientRegistry
InvocationImpl --> RequestMapper
InvocationImpl --> JsonRpcClient
ClientRegistry --> Config
JsonRpcClient --> DownstreamAgents

CompositeA2uiService --> ProductA2uiService
CompositeA2uiService --> ReservationA2uiService

ConversationStoreImpl ..> ConversationStorePort : implements
CheckpointStoreImpl ..> CheckpointStorePort : implements
SwarmStateStoreImpl ..> SwarmStateStorePort : implements
ReviewStoreImpl ..> ReviewStorePort : implements
RedisTaskStore ..> TaskStorePort : implements
InMemoryTaskStore ..> TaskStorePort : implements

ChatGatewayImpl ..> ChatGatewayPort : implements
LlmRuntime --> ChatGatewayPort

note right of AgentService
Current use case split:
- pre-HITL A2UI shortcut
- HITL policy gate
- unary/stream execution
- review approve/cancel streams
end note

note right of GraphFactoryImpl
Current graph nodes:
- plan
- select
- invoke
- handoff_evaluate
- handoff_apply
- merge
- compose
end note

note bottom of ComposeImpl
Compose can emit:
- text events
- A2UI payload
- pre-HITL-only A2UI views are skipped in post-invoke compose
end note

@enduml
